# --- Safety (required) ---
# Comma-separated origins Ghost User may test. Nothing else is reachable: not as a target,
# not as a redirect, not as a sub-resource. Use only sites you are authorised to test.
GHOST_USER_ALLOWED_ORIGINS=http://127.0.0.1:4173

# Credentials as a JSON map of NAME -> value. Agents only ever see the names; values are
# injected inside the browser tool and redacted from logs, evidence and reports.
# GHOST_USER_SECRETS={"demo_password":"demo-pass-123"}

# --- Model ---
# Gateway model id for every agent (default anthropic/claude-sonnet-5). Credentials: AI_GATEWAY_API_KEY
# or a provider key (see eve docs), or `eve dev` /login.
# GHOST_USER_MODEL=anthropic/claude-sonnet-5

# --- Budgets (enforced in code) ---
# GHOST_USER_MAX_BROWSER_ACTIONS_PER_TASK=30
# GHOST_USER_MAX_TASK_RETRIES=1
# GHOST_USER_MAX_DELEGATION_DEPTH=1
# GHOST_USER_MAX_AGENT_INVOCATIONS=14
# GHOST_USER_MAX_ELAPSED_MS=600000
# Enforced by eve's own session limits:
# GHOST_USER_MAX_INPUT_TOKENS=2000000
# GHOST_USER_MAX_COST_USD=3

# --- Runtime ---
# GHOST_USER_RUNS_DIR=runs
# GHOST_USER_EVE_URL=http://127.0.0.1:2000   # where `npm run dev` listens (used by the UI)
# GHOST_USER_UI_PORT=4200
# GHOST_USER_HEADED=1                         # show the browser
# GHOST_USER_CHROMIUM_PATH=/path/to/chromium  # use an existing Chromium

# --- Model provider ---
# Direct Anthropic API (works wherever api.anthropic.com is reachable):
#   GHOST_USER_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=...           # put in a local, git-ignored .env; never commit
# GHOST_USER_PROVIDER=openai + OPENAI_API_KEY also works. Default is the Vercel AI Gateway (AI_GATEWAY_API_KEY).
