{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node", "eve/workflow-modules"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["scripts","agent/**/*.ts", "src/**/*.ts", "evals/**/*.ts", "test/**/*.ts", "ui/**/*.ts", "fixtures/**/*.ts"]
}
